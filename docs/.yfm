allowHTML: true
strict: true
breaks: false
langs: ['ru']
apply-presets: true
varsPreset: 'external'

interface:
  favicon-src: 'https://sun9-29.userapi.com/s/v1/ig2/it3V7x4m3R2aHUpV8GeEe5wY9tWtKOc_wPVvKcJlxB7rMMz6fJmTd-cu7HqI7I_ttn6Nge8hu39TMIEDZlzdS6X-.jpg?quality=95&as=32x4,48x5,72x8,108x12,160x18,240x27,360x41,478x54&from=bu&cs=478x0'
  feedback: true

search:
  provider: local
  tolerance: 0
  confidense: phrased

#allow-custom-resources: true

extensions:
  - './_extensions/breadcrumbs'

breadcrumbs:
  tocAsRoot: true

#docs-viewer:
