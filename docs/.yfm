allowHTML: true
strict: true
breaks: false
langs: ['ru']
apply-presets: true
varsPreset: 'external'

search:
  provider: local
  tolerance: 0
  confidense: phrased

allow-custom-resources: true

extensions:
#  - './_extensions/feedback-control'
  - './_extensions/breadcrumbs'

#feedbackControl:
#  endpoint: https://formspree.io/f/mnjbvjgq

breadcrumbs:
  tocAsRoot: true

